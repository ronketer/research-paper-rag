# Application model. Format: provider:model
PAPER_QA_MODEL=ollama:qwen3:4b

# Optional separate evaluation judge. Defaults to PAPER_QA_MODEL.
PAPER_QA_JUDGE_MODEL=ollama:qwen3:4b

# Optional custom endpoints (Ollama defaults to http://localhost:11434).
# PAPER_QA_MODEL_BASE_URL=http://localhost:11434
# PAPER_QA_JUDGE_BASE_URL=http://localhost:11434

# Provider credentials are read by their LangChain integrations.
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GOOGLE_API_KEY=
# OPENROUTER_API_KEY=

# Required only for evaluation tracking.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# LANGFUSE_BASE_URL=https://cloud.langfuse.com
